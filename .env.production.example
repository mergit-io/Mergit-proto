DOMAIN=mergit.example.com

FRONTEND_URL=https://mergit.example.com
CORS_ORIGINS=https://mergit.example.com
AUTH_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=true

GROQ_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
MERGIT_REPO=mergit-io/Mergit-proto

# Chain. "local" runs a real EVM inside the app process — no keys, no network, but its
# state is wiped on every restart, so proofs are only verifiable from inside the
# container. For a chain that outlives restarts, deploy the contracts first
# (backend/scripts/deploy_contracts.py --network monad-testnet) and set the two below.
CHAIN_ENABLED=true
CHAIN_TARGET=local
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=


OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://mergit.example.com/api/auth/google/callback

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=https://mergit.example.com/api/auth/github/callback

# ── Public deployment ────────────────────────────────────────────────────────────
# REQUIRED on any URL a stranger can reach. The API is unauthenticated by design:
# POST /api/goals accepts a free-form goal, the coder agent's code_exec tool runs the
# result in a subprocess, and PUT /api/config/keys rewrites the provider keys. Empty
# means wide open. Anything non-empty turns on HTTP Basic for every route except
# /api/health (which the container healthcheck needs). Username is ignored.
ACCESS_PASSWORD=

# Mint a canned goal + 3 verifiable proofs on boot when the ledger is empty. Intended
# for hosts with no persistent disk, where each restart otherwise leaves a visitor
# looking at an empty dashboard. Skipped automatically when proofs already exist.
SEED_DEMO=false
