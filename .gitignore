# Python
__pycache__/
*.pyc
*.pyo
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Env
backend/.env
backend/model_config.json
backend/context.json
backend/workspace/

# SQLite — unanchored on purpose. These used to read `backend/mergit.db`, which only
# matched that one path, so any tool run from another cwd (sqlite3.connect creates the
# file when it is missing) left an untracked stray that git happily offered to commit.
# frontend/omnibox.db got committed exactly this way before the rebrand.
*.db
*.db-wal
*.db-shm
*.db-journal

# Frontend
frontend/node_modules/
frontend/dist/

# Solidity build output (recompiled on demand from contracts/src by chain/compiler.py)
backend/contracts/out/

# OS
.DS_Store

backend/logs/

# Local-EVM deployment record is regenerated on every boot (ephemeral in-process chain)
backend/deployments/31337.json
