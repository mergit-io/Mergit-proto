# Mergit backend configuration — copy to .env and fill in what you need.
#   cp .env.example .env
# Every value below has a working default in config.py; nothing here is required to boot.

# ── LLM providers ──────────────────────────────────────────────────────────────
# At least one is needed for real agent runs. Per-role model selection lives in
# model_config.json (edit via the Models page or PUT /api/config/models).
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Last-resort fallback tier: every model chain ends with OpenRouter's copies of
# Llama 3.3 70B and Claude Haiku 4.5, so a Groq daily cap does not fail the goal.
OPENROUTER_API_KEY=

# ── Tools ──────────────────────────────────────────────────────────────────────
# Without a Tavily key, web_search falls back to the DuckDuckGo Instant Answer API,
# which is not a web index and returns nothing for ordinary developer queries.
TAVILY_API_KEY=
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=owner/repo
# Repo where self-heal files its auto-detected bug issues
MERGIT_REPO=mergit-io/Mergit-proto
# Optional: verifies GitHub webhook signatures when set
# The webhook receiver FAILS CLOSED without this: unset, it rejects every event outside
# DEBUG. It used to fail *open*, which meant a forged issues.opened carrying an
# attacker-chosen repository.full_name could point the agent pipeline anywhere.
GITHUB_WEBHOOK_SECRET=

# ── Chain (real EVM proof-of-work) ─────────────────────────────────────────────
# "local"  = in-process EVM. Real bytecode, real tx hashes, real event logs, but no
#            RPC, no private key and no tokens required. Contracts redeploy on boot.
# "monad-testnet" = Monad testnet, chainId 10143. Needs CHAIN_RPC_URL and a funded
#            CHAIN_PRIVATE_KEY, then: python scripts/deploy_contracts.py --network monad-testnet
CHAIN_ENABLED=true
CHAIN_TARGET=local
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
CHAIN_SUBMIT_INTERVAL_SECONDS=2.0

# Free testnet MON for the deployer address:
#   https://faucet.monad.xyz               10 MON/24h  (needs >=0.001 ETH on Ethereum mainnet)
#   https://chainstack.com/monad-faucet    0.5 MON/24h (no gate)
#   https://faucet.quicknode.com/monad     1 drip/12h
#   https://www.alchemy.com/faucets/monad-testnet

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DB_PATH=./mergit.db
WORKSPACE_DIR=./workspace
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
DEBUG=false

# ── Worker ─────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_TASKS=5
LEASE_SECONDS=300
POLL_INTERVAL_SECONDS=1.0

# ── Identity: Sign in with Google ──────────────────────────────────────────────
# Auth turns ON when these two are set — there is no separate flag, because a boolean
# is a way to ship an open deployment by accident. Unset, Mergit runs single-tenant and
# everything belongs to one local user, which is right on a laptop.
#
# In Google Cloud Console, register the callback below as an Authorized redirect URI.
# Register BOTH the localhost one and your deployed one on the same OAuth client.
#
# Scopes are `openid email profile` and never change. They are non-sensitive, so this app
# needs no Google verification and no CASA assessment — a real cost, in weeks and money,
# avoided entirely by keeping Google to identity. Publish the consent screen out of
# "Testing" though, or you are capped at 100 users.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Signs the OAuth transaction cookie and connection `state`. Boot FAILS if this is left
# at the default while Google is configured.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=change-me-in-env
# `false` for local http. Safari refuses Secure cookies on http://localhost, so leaving
# this true in dev means sign-in silently fails there and nowhere else.
COOKIE_SECURE=false
# Comma-separated. Who may manage the deployment's shared provider keys and model config.
# Recomputed on every login, so removing an address revokes it at their next sign-in.
ADMIN_EMAILS=

# ── Credential vault ───────────────────────────────────────────────────────────
# Wraps the per-row keys that encrypt users' stored OAuth tokens. Read once at startup
# then removed from the environment, before the worker starts.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# LOSE THIS AND EVERY STORED CONNECTION IS UNRECOVERABLE.
MERGIT_KEK_CURRENT=
# Retired keys as "id:base64key,id2:base64key2". Only needed during a rotation.
MERGIT_KEK_PREVIOUS=

# ── Delegated authority: GitHub App ────────────────────────────────────────────
# A GitHub App, not an OAuth App. The user picks which repositories Mergit may touch at
# install time and GitHub enforces it, so the allowlist is a property of the credential
# rather than a prompt instruction. Create one at
# https://github.com/settings/apps/new with these repository permissions:
#   Contents: Read & write · Pull requests: Read & write · Issues: Read & write
#   Administration: Read & write (needed to create a repository) · Metadata: Read
# Deliberately NOT Workflows — github_pr refuses .github/workflows/** paths instead.
GITHUB_APP_ID=
GITHUB_APP_SLUG=mergit
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM. Newlines may be written as literal \n so it survives a one-line env var.
GITHUB_APP_PRIVATE_KEY=

# ── Delegated authority: Slack ─────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ── GitHub is NOT an identity provider ─────────────────────────────────────────
# These three are dead and kept only so an existing .env does not break. Signing in with
# GitHub would grant Mergit nothing ON GitHub — that is what the GitHub App above is for,
# and conflating the two is the single most common misunderstanding of this design.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=



# ── Demo posture ───────────────────────────────────────────────────────────────
# Unregisters code_exec entirely, and removes it from the coder's toolset. It runs
# model-authored Python in a subprocess of the API server — fine on a laptop, not fine on
# a public URL where POST /api/goals is reachable by anyone. Set true on any deployment
# until code_exec runs out of process.
DEMO_SAFE_MODE=false

# ── Durable storage on an ephemeral host ───────────────────────────────────────
# Litestream streams the SQLite file to object storage and restores it on boot, which is
# what makes a free tier with no persistent disk survivable. Leave LITESTREAM_BUCKET unset
# to run without replication. Backblaze B2 is the recommended target — its Class A/B/C
# transactions are free with no daily cap, so there is no operation quota to exhaust.
#
# On B2, set the bucket lifecycle rule to "Keep only the last version of the file":
# B2 keeps every version by default and Litestream deletes files as it compacts, so each
# delete leaves a hidden version that still bills against the free 10 GB.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
