# Bypasses login entirely. Correct for demos, wrong for anything public — the backend's
# key-management endpoints are unauthenticated, so a reachable URL with demo mode on lets
# anyone read and overwrite your provider API keys.
VITE_DEMO_MODE=true

# Firebase auth — only needed when VITE_DEMO_MODE=false.
# Create a project at console.firebase.google.com, enable the Google and GitHub sign-in
# providers, then copy the web-app config here. These values are not secrets: Firebase web
# config is embedded in every client bundle by design. Access is controlled by Auth rules
# and API-key restrictions in the console, so restrict the key to your deployed domain.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
